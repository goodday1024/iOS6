# Copy to .env and replace every CHANGE_ME value before Docker Compose.
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_DATABASE_PASSWORD
S3_ACCESS_KEY=retro6-local
S3_SECRET_KEY=CHANGE_ME_RANDOM_OBJECT_PASSWORD
S3_PUBLIC_ENDPOINT=http://localhost:9000
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_AT_LEAST_12_RANDOM_CHARACTERS
# Local Python mode defaults to SQLite + local files; optional:
# DATABASE_URL=sqlite:///./data/platform.db
# DATA_DIR=data
# RELEASE_KEY_BASE64=<32-byte Ed25519 private key in Base64; keep confidential>
# Production: configure an authenticator with this Base32 secret.
# ADMIN_TOTP_SECRET=<random Base32 secret; keep confidential>
